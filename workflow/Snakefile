"""Project-level Snakemake workflow.

One entry point, one subworkflow per experiment. ``docs/snakemake_design.md``
calls for exactly this arrangement: shared rules defined once, analyses kept
methodologically independent, and each experiment selectable on its own.

Usage (from the repository root)::

    snakemake -s workflow/Snakefile -n                    # dry run
    snakemake -s workflow/Snakefile --cores 4             # execute everything
    snakemake -s workflow/Snakefile fit_to_ephemeris      # one experiment only
    snakemake -s workflow/Snakefile --report report.html  # final HTML report
    snakemake -s workflow/Snakefile --dag | dot -Tpdf > dag.pdf

``rule all`` is assembled from the per-experiment completion stamps, so a plain
``snakemake`` builds every experiment while naming one selects just that one.
The aggregate target lives here rather than in the experiment files so that
"what does the whole project produce" is stated in exactly one place.

Why the stage rules live in ``workflow/rules/``
-----------------------------------------------
Keeping them out of this file means an experiment's ``.smk`` reads as a
declaration of *what* it wants, not *how* each stage runs. The stage rules --
and the two kinds of explicit dependency (Python import closure and the Hydra
config tree) -- are shared by every experiment and live in ``common.smk``.
"""

import sys

configfile: "workflow/config.yaml"

# Make ``depgraph`` (and anything else the rule modules import) resolvable.
sys.path.insert(0, workflow.basedir)

# ``include:`` paths resolve relative to this file's directory, so they are
# written relative to ``workflow/`` rather than to the invocation directory.
include: "rules/common.smk"
include: "rules/figures.smk"
include: "rules/sweeps.smk"

EXPERIMENTS = config["experiments"]
SWEEPS = config.get("sweeps", {})

# Landing-page description of the report, rendered as RST by ``--report``.
#
# A workflow-level description rather than a per-result caption: the captions
# under ``report/`` explain one figure each, this explains what the report as a
# whole is. It goes through the same helper the figure captions use, so it
# resolves to ``report/workflow.rst`` regardless of the invocation directory.
report: _caption("workflow.rst")

for _experiment in EXPERIMENTS:
    include: f"experiments/{_experiment}.smk"


rule all:
    """Build every experiment and every sweep.

    Each experiment's target rule is named after its config, so the same name
    selects it on the command line (``snakemake classic_triton_state``) without
    pulling in the others. The same holds for sweeps (``snakemake sweep_fit_to_ephemeris``).
    """
    default_target: True
    input:
        [f"results/{experiment}/.complete" for experiment in EXPERIMENTS]
        + [f"sweeps/{sweep}/.complete" for sweep in SWEEPS]


rule sweep:
    """Build one sweep: all combinations, the telemetry table, and the charts.

    Named per sweep (``sweep_<name>``) so a single sweep can be built without
    the others, and so a 32-combination sweep does not have to be re-run when an
    unrelated experiment changes.
    """
    input:
        "sweeps/{sweep}/sweep_telemetry.csv",
        expand(
            "sweeps/{{sweep}}/figures/sweep_comparison_{metric}.pdf",
            metric=SWEEP_METRICS,
        ),
    output:
        touch("sweeps/{sweep}/.complete")
